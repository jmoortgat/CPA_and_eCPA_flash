# ── Repository-root allowlist ────────────────────────────────────────────────
# Everything at the top level is ignored unless it is named below.  This is a
# safety net: a stray `git add -A` run from the repository root can never pick
# up a scratch directory, a manuscript, or an unrelated project that happens to
# sit alongside this one in someone's workspace.  Adding a new top-level entry
# to the release means adding it here deliberately.
/*
!/.gitattributes
!/.github/
!/.gitignore
!/.zenodo.json
!/CHANGELOG.md
!/CITATION.cff
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/REPRODUCING_FIGURES.md
!/paper.bib
!/paper.md
!/pyproject.toml
!/EXP/
!/code/
!/notebooks/
!/tests/

# The experimental CO2 + H2O database: one curated parquet, not the raw
# working directory that surrounds it.
!/CO2/
/CO2/*
!/CO2/CO2_WATER_exp.parquet

# ── Ignored anywhere in the tree ─────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv/
env/
venv/
ENV/

# Build artifacts
build/
dist/

# Editors and OS
.ipynb_checkpoints/
.DS_Store

# Generated output (regenerable; not distributed).  `results/` covers both the
# root-level scratch directory and `code/results/`; the handful of tables that
# ship with the repository are tracked explicitly and stay tracked.
figures/
logs/
results/
*.log
*.slurm

# Intermediate scan tables that exceed sensible repository size.  The tables
# that *are* distributed (CPA_ELV_all.parquet, scan_v4_table.npz,
# solution_table.npz) are tracked explicitly.
code/results/scan_v3_table.npz
code/results/scan_v2_table.npz
