\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces CO$_2$ solubility in NaCl brine at thirteen temperatures not shown in Fig.~\ref {fig:co2nacl_Tpanel} ($5$--$350\,^\circ $C), including data at high NaCl molalities up to $m_s = 6$\,mol\,kg$^{-1}$ from multiple sources. Each panel shows CO$_2$ molality $m_{\text  {CO}_2}$ [mol\,kg$^{-1}$] vs.\ pressure (log--log). Open symbols: experimental data \citep  {Guo2015, Rumpf1994, Bando2003, Chabab2020, Liu2021, Liu2011b, Nighswander1989, Takenouchi1965, Yan2011}; discrete lines with markers: eCPA at the experimental NaCl molalities. Rainbow-colored background bands: continuous eCPA predictions across $m_s = 0$--$6$\,mol\,kg$^{-1}$ (color scale as in Fig.~\ref {fig:co2h2o_Tpanel}). At $T \geq 400\,^\circ $C, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures.}}{52}{figure.caption.62}\protected@file@percent }
\newlabel{fig:co2nacl_Tpanel_SI}{{S2}{52}{CO$_2$ solubility in NaCl brine at thirteen temperatures not shown in Fig.~\ref {fig:co2nacl_Tpanel} ($5$--$350\,^\circ $C), including data at high NaCl molalities up to $m_s = 6$\,mol\,kg$^{-1}$ from multiple sources. Each panel shows CO$_2$ molality $m_{\text {CO}_2}$ [mol\,kg$^{-1}$] vs.\ pressure (log--log). Open symbols: experimental data \citep {Guo2015, Rumpf1994, Bando2003, Chabab2020, Liu2021, Liu2011b, Nighswander1989, Takenouchi1965, Yan2011}; discrete lines with markers: eCPA at the experimental NaCl molalities. Rainbow-colored background bands: continuous eCPA predictions across $m_s = 0$--$6$\,mol\,kg$^{-1}$ (color scale as in Fig.~\ref {fig:co2h2o_Tpanel}). At $T \geq 400\,^\circ $C, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures}{figure.caption.62}{}}
