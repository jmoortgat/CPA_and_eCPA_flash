\@writefile{toc}{\contentsline {paragraph}{Comparison with CO$_2$-saturation experiments}{42}{section*.53}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Aqueous-phase density of CO$_2$-saturated water ($m_s = 0$) predicted by eCPA versus experimental data from \citet  {King1992} and \citet  {Nighswander1989} (37 points, $T = 15$--$200\,^\circ $C). Points are colored by temperature; shaded bands show $\pm $1\% and $\pm $2\% deviations. No Péneloux volume shift is applied to H$_2$O; the 0.76\% AARE reflects the liquid-density accuracy intrinsic to the CPA parameterization.}}{42}{figure.caption.54}\protected@file@percent }
\newlabel{fig:density}{{S5}{42}{Aqueous-phase density of CO$_2$-saturated water ($m_s = 0$) predicted by eCPA versus experimental data from \citet {King1992} and \citet {Nighswander1989} (37 points, $T = 15$--$200\,^\circ $C). Points are colored by temperature; shaded bands show $\pm $1\% and $\pm $2\% deviations. No Péneloux volume shift is applied to H$_2$O; the 0.76\% AARE reflects the liquid-density accuracy intrinsic to the CPA parameterization}{figure.caption.54}{}}
\@writefile{toc}{\contentsline {paragraph}{Comparison with IAPWS-95 over the full paper range}{42}{section*.55}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Signed relative error of eCPA pure-water density predictions versus the IAPWS-95 reference equation \citep  {IAPWS2016} over $T = 0$--$350\,^\circ $C and $P = 1$--$2\,000$\,bar (475 liquid/compressed-water conditions; vapour excluded). The $P$-axis is logarithmic. The transparent grey plane marks zero error. Blue regions indicate conditions where eCPA slightly over-predicts density (near 0\,$^\circ $C); red regions where it slightly under-predicts (50--150\,$^\circ $C); the narrow red spike near 350\,$^\circ $C at moderate pressures corresponds to the highly compressible near-saturation liquid where cubic-EoS predictions are least accurate.}}{43}{figure.caption.56}\protected@file@percent }
\newlabel{fig:density_surface}{{S6}{43}{Signed relative error of eCPA pure-water density predictions versus the IAPWS-95 reference equation \citep {IAPWS2016} over $T = 0$--$350\,^\circ $C and $P = 1$--$2\,000$\,bar (475 liquid/compressed-water conditions; vapour excluded). The $P$-axis is logarithmic. The transparent grey plane marks zero error. Blue regions indicate conditions where eCPA slightly over-predicts density (near 0\,$^\circ $C); red regions where it slightly under-predicts (50--150\,$^\circ $C); the narrow red spike near 350\,$^\circ $C at moderate pressures corresponds to the highly compressible near-saturation liquid where cubic-EoS predictions are least accurate}{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Absolute relative error of eCPA predictions for the CO$_2$ + H$_2$O binary as a function of temperature and pressure. Left: CO$_2$ solubility in the aqueous phase ($x_{\text  {CO}_2}$). Right: H$_2$O content in the CO$_2$-rich phase ($y_{\text  {H}_2\text  {O}}$). Marker color indicates error magnitude (green $< 5\%$, yellow $\approx 10\%$, red $> 30\%$); crosses mark points flagged as outliers by cross-reference consistency analysis. The blue shaded band highlights the pressure range most relevant to subsurface CO$_2$ storage ($P = 50$--$600$\,bar).}}{44}{figure.caption.57}\protected@file@percent }
\newlabel{fig:error_heatmap_SI}{{S7}{44}{Absolute relative error of eCPA predictions for the CO$_2$ + H$_2$O binary as a function of temperature and pressure. Left: CO$_2$ solubility in the aqueous phase ($x_{\text {CO}_2}$). Right: H$_2$O content in the CO$_2$-rich phase ($y_{\text {H}_2\text {O}}$). Marker color indicates error magnitude (green $< 5\%$, yellow $\approx 10\%$, red $> 30\%$); crosses mark points flagged as outliers by cross-reference consistency analysis. The blue shaded band highlights the pressure range most relevant to subsurface CO$_2$ storage ($P = 50$--$600$\,bar)}{figure.caption.57}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {S4.2}Simplified flash: detailed accuracy and efficiency}{44}{subsection.D.2}\protected@file@percent }
\newlabel{sec:simplified_si}{{S4.2}{44}{Simplified flash: detailed accuracy and efficiency}{subsection.D.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {D.11}{\ignorespaces Accuracy of the simplified flash ($y_{\text  {H}_2\text  {O}} = 0$) relative to the full K-value SSI flash, evaluated over 3{,}285 two-phase conditions spanning $P = 25$--$800$\,bar, $z_{\text  {CO}_2} = 0.01$--$0.70$, and $m_s = 1$--$6$\,mol\,kg$^{-1}$. AARE: average absolute relative error in CO$_2$ molality $m_c$; $\langle y_{\text  {H}_2\text  {O}}\rangle $: mean H$_2$O mole fraction in the CO$_2$-rich phase from the full flash (proxy for the assumption error).}}{45}{table.caption.58}\protected@file@percent }
\newlabel{tab:simplified_accuracy}{{D.11}{45}{Accuracy of the simplified flash ($y_{\text {H}_2\text {O}} = 0$) relative to the full K-value SSI flash, evaluated over 3{,}285 two-phase conditions spanning $P = 25$--$800$\,bar, $z_{\text {CO}_2} = 0.01$--$0.70$, and $m_s = 1$--$6$\,mol\,kg$^{-1}$. AARE: average absolute relative error in CO$_2$ molality $m_c$; $\langle y_{\text {H}_2\text {O}}\rangle $: mean H$_2$O mole fraction in the CO$_2$-rich phase from the full flash (proxy for the assumption error)}{table.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces Simplified flash benchmark over 3{,}285 two-phase conditions ($P = 25$--$800$\,bar; $z_{\text  {CO}_2} = 0.01$--$0.70$; $m_s = 1$--$6$\,mol\,kg$^{-1}$). \textbf  {Left}: AARE in dissolved CO$_2$ molality $m_c$ as a function of temperature; the dashed line marks 5\%. \textbf  {Middle}: mean H$_2$O mole fraction in the CO$_2$-rich phase from the full flash, which directly quantifies the magnitude of the $y_{\text  {H}_2\text  {O}} = 0$ assumption; dashed line at 1\,mol\%. \textbf  {Right}: ratio of mean full-flash wall time to simplified-flash wall time; the two methods are essentially iso-cost across all temperatures.}}{46}{figure.caption.59}\protected@file@percent }
\newlabel{fig:simplified_accuracy}{{S8}{46}{Simplified flash benchmark over 3{,}285 two-phase conditions ($P = 25$--$800$\,bar; $z_{\text {CO}_2} = 0.01$--$0.70$; $m_s = 1$--$6$\,mol\,kg$^{-1}$). \textbf {Left}: AARE in dissolved CO$_2$ molality $m_c$ as a function of temperature; the dashed line marks 5\%. \textbf {Middle}: mean H$_2$O mole fraction in the CO$_2$-rich phase from the full flash, which directly quantifies the magnitude of the $y_{\text {H}_2\text {O}} = 0$ assumption; dashed line at 1\,mol\%. \textbf {Right}: ratio of mean full-flash wall time to simplified-flash wall time; the two methods are essentially iso-cost across all temperatures}{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces AARE in dissolved CO$_2$ molality $m_c$ of the simplified flash versus the full K-value SSI, broken down by NaCl molality ($m_s = 1$--$6$\,mol\,kg$^{-1}$). The error curves for different salinities are nearly coincident, confirming that the accuracy of the $y_{\text  {H}_2\text  {O}} = 0$ approximation is controlled entirely by temperature and is insensitive to brine salinity. The dashed line marks 5\%.}}{46}{figure.caption.60}\protected@file@percent }
\newlabel{fig:simplified_by_ms}{{S9}{46}{AARE in dissolved CO$_2$ molality $m_c$ of the simplified flash versus the full K-value SSI, broken down by NaCl molality ($m_s = 1$--$6$\,mol\,kg$^{-1}$). The error curves for different salinities are nearly coincident, confirming that the accuracy of the $y_{\text {H}_2\text {O}} = 0$ approximation is controlled entirely by temperature and is insensitive to brine salinity. The dashed line marks 5\%}{figure.caption.60}{}}
