# ── code/ allowlist ──────────────────────────────────────────────────────────
# Same approach as the repository-root .gitignore: ignore every entry in this
# directory by default and re-include the ones that belong in the release, so
# local notes, scratch data, cluster job files and generated output can never
# be added by accident.  Adding a new module or script means listing it here.
/*
!/.gitignore
!/environment.yml
!/CPA.py
!/benchmark_flash.py
!/co2brine_simulator.py
!/cpa_worker.py
!/ecpa_worker.py
!/ecpa_worker_brent.py
!/ecpa_worker_ssi.py
!/ecpa/
!/scripts/

# results/ is ignored by the repository-root .gitignore because everything in
# it is a regenerable intermediate.  Four tables are exceptions and are tracked
# explicitly so a fresh clone can reproduce the figures:
#     results/CPA_ELV_all.parquet
#     results/solution_table.npz
#     results/scan_v4_table.npz
#     results/scan_v4_metrics.parquet
# plus the validation parquets the plotting scripts read.
