\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comparison of CPA flash strategies over 35 T $\times $ 200 P = 7{,}000 conditions ($z_{\text  {CO}_2} = 0.5$). \emph  {Left}: wall-time distributions (log scale); medians shown as dashed lines. CPA2 robust (blue): 6-trial Michelsen + K-value SSI, no warm-start, median 239\,ms. K-value SSI with $m_s{=}0$ table warm-start (red): median 8\,ms, a $30\times $ speedup. \emph  {Center}: iteration distributions; the table warm-start yields a tight distribution (median~5, max~10) vs.\ the robust solver (median~8, long tail). \emph  {Right}: composition parity; the two methods agree to within 1.1\% AARE for $x_{\text  {CO}_2}$ (circles) and 3.9\% for $y_{\text  {H}_2\text  {O}}$ (triangles) on two-phase conditions.}}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:cpa_warmstart}{{5}{18}{Comparison of CPA flash strategies over 35 T $\times $ 200 P = 7{,}000 conditions ($z_{\text {CO}_2} = 0.5$). \emph {Left}: wall-time distributions (log scale); medians shown as dashed lines. CPA2 robust (blue): 6-trial Michelsen + K-value SSI, no warm-start, median 239\,ms. K-value SSI with $m_s{=}0$ table warm-start (red): median 8\,ms, a $30\times $ speedup. \emph {Center}: iteration distributions; the table warm-start yields a tight distribution (median~5, max~10) vs.\ the robust solver (median~8, long tail). \emph {Right}: composition parity; the two methods agree to within 1.1\% AARE for $x_{\text {CO}_2}$ (circles) and 3.9\% for $y_{\text {H}_2\text {O}}$ (triangles) on two-phase conditions}{figure.caption.16}{}}
