\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Benchmark of flash strategies at $T = 398$\,K, $z_{\text  {CO}_2} = 0.5$, $m_s = 1.0$\,mol\,kg$^{-1}$, 30 pressure points.}}{17}{table.caption.18}\protected@file@percent }
\newlabel{tab:benchmark}{{3}{17}{Benchmark of flash strategies at $T = 398$\,K, $z_{\text {CO}_2} = 0.5$, $m_s = 1.0$\,mol\,kg$^{-1}$, 30 pressure points}{table.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces eCPA flash results as a function of overall CO$_2$ feed mole fraction $z$ at $P = 200$\,bar, feed molality $m_\mathrm  {feed} = 1.0$\,mol\,kg$^{-1}$ NaCl, and four temperatures (350, 400, 450, 500\,K). (a) CO$_2$-rich phase fraction $\beta $; the two-phase window narrows at higher temperature. (b) Ratio of equilibrium aqueous NaCl molality to feed molality, $m_s^\mathrm  {aq}/m_\mathrm  {feed}$; NaCl concentrates in the aqueous phase as H$_2$O partitions to the CO$_2$-rich phase, reaching a factor of 2.2 at $T = 500$\,K. (c) CO$_2$ molality $m_c$ in the aqueous phase; the salting-out effect driven by the elevated $m_s^\mathrm  {aq}$ reduces CO$_2$ solubility with increasing $z$. (d) H$_2$O mole fraction in the CO$_2$-rich phase $y_{\text  {H}_2\text  {O}}$; substantial water content at high temperatures (up to 23\,mol\% at 500\,K) and its variation with $z$ highlight the need for full flash rather than a fixed-salinity VLE lookup.}}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:flash_vs_z}{{6}{18}{eCPA flash results as a function of overall CO$_2$ feed mole fraction $z$ at $P = 200$\,bar, feed molality $m_\mathrm {feed} = 1.0$\,mol\,kg$^{-1}$ NaCl, and four temperatures (350, 400, 450, 500\,K). (a) CO$_2$-rich phase fraction $\beta $; the two-phase window narrows at higher temperature. (b) Ratio of equilibrium aqueous NaCl molality to feed molality, $m_s^\mathrm {aq}/m_\mathrm {feed}$; NaCl concentrates in the aqueous phase as H$_2$O partitions to the CO$_2$-rich phase, reaching a factor of 2.2 at $T = 500$\,K. (c) CO$_2$ molality $m_c$ in the aqueous phase; the salting-out effect driven by the elevated $m_s^\mathrm {aq}$ reduces CO$_2$ solubility with increasing $z$. (d) H$_2$O mole fraction in the CO$_2$-rich phase $y_{\text {H}_2\text {O}}$; substantial water content at high temperatures (up to 23\,mol\% at 500\,K) and its variation with $z$ highlight the need for full flash rather than a fixed-salinity VLE lookup}{figure.caption.16}{}}
