\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces CO$_2$ + H$_2$O phase equilibria at all 29 temperatures not shown in Fig.~\ref {fig:co2h2o_Tpanel} (273--623\,K), 4 panels per row. Each panel shows the CO$_2$ mole fraction in the aqueous phase ($x_{\text  {CO}_2}$, left sub-panel) and H$_2$O mole fraction in the CO$_2$-rich phase ($y_{\text  {H}_2\text  {O}}$, right sub-panel) vs.\ pressure. Open symbols: experimental data \citep  {Coelho2025}; black solid line: CPA (salt-free); dashed rainbow lines: eCPA at $m_s = 0$--$6$\,mol\,kg$^{-1}$ (violet to red).}}{32}{figure.caption.40}\protected@file@percent }
\newlabel{fig:co2h2o_Tpanel_SI}{{S1}{32}{CO$_2$ + H$_2$O phase equilibria at all 29 temperatures not shown in Fig.~\ref {fig:co2h2o_Tpanel} (273--623\,K), 4 panels per row. Each panel shows the CO$_2$ mole fraction in the aqueous phase ($x_{\text {CO}_2}$, left sub-panel) and H$_2$O mole fraction in the CO$_2$-rich phase ($y_{\text {H}_2\text {O}}$, right sub-panel) vs.\ pressure. Open symbols: experimental data \citep {Coelho2025}; black solid line: CPA (salt-free); dashed rainbow lines: eCPA at $m_s = 0$--$6$\,mol\,kg$^{-1}$ (violet to red)}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces CO$_2$ solubility in NaCl brine at nine representative temperatures not shown in Fig.~\ref {fig:co2nacl_Tpanel} (278--473\,K), including data at high NaCl molalities up to $m_s = 6$\,mol\,kg$^{-1}$ from multiple sources. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure (log--log). Open symbols: experimental data; lines: eCPA. Colors and markers distinguish NaCl molalities (see legend).}}{33}{figure.caption.41}\protected@file@percent }
\newlabel{fig:co2nacl_Tpanel_SI}{{S2}{33}{CO$_2$ solubility in NaCl brine at nine representative temperatures not shown in Fig.~\ref {fig:co2nacl_Tpanel} (278--473\,K), including data at high NaCl molalities up to $m_s = 6$\,mol\,kg$^{-1}$ from multiple sources. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure (log--log). Open symbols: experimental data; lines: eCPA. Colors and markers distinguish NaCl molalities (see legend)}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces CO$_2$ solubility in NaCl brine at hydrothermal temperatures (a) $T = 573$\,K, (b) $T = 623$\,K. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure. Open symbols: experimental data \citep  {Takenouchi1965}; lines: eCPA. At $T \geq 673$\,K, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures (300--900\,bar).}}{34}{figure.caption.42}\protected@file@percent }
\newlabel{fig:co2nacl_highT_SI}{{S3}{34}{CO$_2$ solubility in NaCl brine at hydrothermal temperatures (a) $T = 573$\,K, (b) $T = 623$\,K. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure. Open symbols: experimental data \citep {Takenouchi1965}; lines: eCPA. At $T \geq 673$\,K, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures (300--900\,bar)}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Absolute relative error of eCPA predictions for the CO$_2$ + H$_2$O binary as a function of temperature and pressure. Left: CO$_2$ solubility in the aqueous phase ($x_{\text  {CO}_2}$). Right: H$_2$O content in the CO$_2$-rich phase ($y_{\text  {H}_2\text  {O}}$). Marker color indicates error magnitude (green $< 5\%$, yellow $\approx 10\%$, red $> 30\%$); crosses mark points flagged as outliers by cross-reference consistency analysis. The blue shaded band highlights the pressure range most relevant to subsurface CO$_2$ storage ($P = 50$--$600$\,bar).}}{34}{figure.caption.43}\protected@file@percent }
\newlabel{fig:error_heatmap_SI}{{S4}{34}{Absolute relative error of eCPA predictions for the CO$_2$ + H$_2$O binary as a function of temperature and pressure. Left: CO$_2$ solubility in the aqueous phase ($x_{\text {CO}_2}$). Right: H$_2$O content in the CO$_2$-rich phase ($y_{\text {H}_2\text {O}}$). Marker color indicates error magnitude (green $< 5\%$, yellow $\approx 10\%$, red $> 30\%$); crosses mark points flagged as outliers by cross-reference consistency analysis. The blue shaded band highlights the pressure range most relevant to subsurface CO$_2$ storage ($P = 50$--$600$\,bar)}{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces SSI + Newton polish iteration breakdown and wall-time ratio across the parameter-space scan (9{,}825 two-phase points, averaged over $z_{\text  {CO}_2}$). \emph  {Left}: mean SSI iteration count before Newton polish is triggered ($\|\mathbf  {g}\| < 10^{-4}$); the near-CO$_2$-critical region ($T \approx 280$--$330$\,K) requires the most SSI iterations even with table warm-start. \emph  {Centre}: mean Newton iteration count; most of the domain converges in 2--3 Newton steps after 1--5 SSI steps, while the critical region (blue) often reverts to SSI before Newton is beneficial. \emph  {Right}: wall-time ratio (SSI-only / SSI+Newton); values $>1$ (green) indicate that Newton polish is faster; values $<1$ (red) indicate that the SSI-only path is faster (primarily near the CO$_2$ critical point where Newton reversion adds overhead).}}{35}{figure.caption.44}\protected@file@percent }
\newlabel{fig:newton_heatmap_SI}{{S5}{35}{SSI + Newton polish iteration breakdown and wall-time ratio across the parameter-space scan (9{,}825 two-phase points, averaged over $z_{\text {CO}_2}$). \emph {Left}: mean SSI iteration count before Newton polish is triggered ($\|\mathbf {g}\| < 10^{-4}$); the near-CO$_2$-critical region ($T \approx 280$--$330$\,K) requires the most SSI iterations even with table warm-start. \emph {Centre}: mean Newton iteration count; most of the domain converges in 2--3 Newton steps after 1--5 SSI steps, while the critical region (blue) often reverts to SSI before Newton is beneficial. \emph {Right}: wall-time ratio (SSI-only / SSI+Newton); values $>1$ (green) indicate that Newton polish is faster; values $<1$ (red) indicate that the SSI-only path is faster (primarily near the CO$_2$ critical point where Newton reversion adds overhead)}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Flash strategy comparison across all 9{,}825 two-phase conditions ($T = 273$--$698$\,K, $P = 1$--$1500$\,bar, $z_{\text  {CO}_2} = 0.001$--$0.999$). (a) Convergence rate; (b) mean total iterations (converged points only). Strategies are ordered from simplest cold-start (standard SSI with Wilson K) to the most optimized (table warm-start with SSI and Newton polish). The final strategy achieves a 73\% reduction in mean iterations relative to the standard cold-start.}}{35}{figure.caption.45}\protected@file@percent }
\newlabel{fig:strategy_comparison_SI}{{S6}{35}{Flash strategy comparison across all 9{,}825 two-phase conditions ($T = 273$--$698$\,K, $P = 1$--$1500$\,bar, $z_{\text {CO}_2} = 0.001$--$0.999$). (a) Convergence rate; (b) mean total iterations (converged points only). Strategies are ordered from simplest cold-start (standard SSI with Wilson K) to the most optimized (table warm-start with SSI and Newton polish). The final strategy achieves a 73\% reduction in mean iterations relative to the standard cold-start}{figure.caption.45}{}}
