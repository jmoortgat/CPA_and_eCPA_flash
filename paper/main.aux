\@writefile{toc}{\contentsline {paragraph}{Two-phase window.}{21}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Fraction of CO$_2$ feed compositions $z \in [0.05, 0.90]$ (25 values, uniformly spaced) that are in the two-phase region at each $(T, P)$ point, for six NaCl molalities (columns). A value of 1 indicates that every feed fraction tested is two-phase; 0 indicates that all are single-phase. The broad pink region confirms that CO$_2$--brine systems are two-phase over most of the geologically relevant $T$--$P$ range. Increasing NaCl molality progressively narrows the two-phase window, while high temperatures ($T \gtrsim 300\,^\circ $C) drive the system toward complete miscibility.}}{21}{figure.caption.24}\protected@file@percent }
\newlabel{fig:ecpa_phase_map}{{8}{21}{Fraction of CO$_2$ feed compositions $z \in [0.05, 0.90]$ (25 values, uniformly spaced) that are in the two-phase region at each $(T, P)$ point, for six NaCl molalities (columns). A value of 1 indicates that every feed fraction tested is two-phase; 0 indicates that all are single-phase. The broad pink region confirms that CO$_2$--brine systems are two-phase over most of the geologically relevant $T$--$P$ range. Increasing NaCl molality progressively narrows the two-phase window, while high temperatures ($T \gtrsim 300\,^\circ $C) drive the system toward complete miscibility}{figure.caption.24}{}}
