\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Equilibrium H$_2$O mole fraction in the CO$_2$-rich phase ($y_{\text  {H}_2\text  {O}}$, mol\%) over the $T$--$P$ plane, on the same grid as Fig.~\ref {fig:ecpa_aq_grid}. Unlike $x_{\text  {CO}_2}$, water content in the CO$_2$-rich phase is governed almost entirely by temperature (water vapour pressure), producing near-vertical isopleths that are nearly independent of pressure and NaCl molality. Red curves show the phase envelope (solid: dew point; dashed: bubble point); their near-identical positions across columns confirm that NaCl has little influence on the tie-line endpoints, only on the extent of the two-phase window. At temperatures above $250\,^\circ $C the CO$_2$-rich phase contains more than 25\,mol\% H$_2$O, approaching 70\,mol\% at the highest temperatures---a regime relevant to geothermal CO$_2$ storage.}}{24}{figure.caption.28}\protected@file@percent }
\newlabel{fig:ecpa_c_grid}{{10}{24}{Equilibrium H$_2$O mole fraction in the CO$_2$-rich phase ($y_{\text {H}_2\text {O}}$, mol\%) over the $T$--$P$ plane, on the same grid as Fig.~\ref {fig:ecpa_aq_grid}. Unlike $x_{\text {CO}_2}$, water content in the CO$_2$-rich phase is governed almost entirely by temperature (water vapour pressure), producing near-vertical isopleths that are nearly independent of pressure and NaCl molality. Red curves show the phase envelope (solid: dew point; dashed: bubble point); their near-identical positions across columns confirm that NaCl has little influence on the tie-line endpoints, only on the extent of the two-phase window. At temperatures above $250\,^\circ $C the CO$_2$-rich phase contains more than 25\,mol\% H$_2$O, approaching 70\,mol\% at the highest temperatures---a regime relevant to geothermal CO$_2$ storage}{figure.caption.28}{}}
\citation{Aavatsmark2003}
\citation{Aavatsmark2003}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Median number of K-value SSI iterations (with Jex acceleration) required for flash convergence, over the $T$--$P$ plane for six NaCl molalities (columns). At each $(T,P)$ point the median is computed over all 25 CO$_2$ feed fractions $z$, counting only two-phase conditions. Grey regions are single-phase for all $z$ at those $(T,P,m_s)$ conditions. The colormap is clipped at 20; a small number of cells near the phase boundaries exceed this value. Iteration counts are lowest in the interior of the two-phase region and highest near the bubble-point boundary and the CO$_2$ critical point, where K-values approach unity and successive substitution converges slowly.}}{25}{figure.caption.30}\protected@file@percent }
\newlabel{fig:ecpa_ssi_heatmap}{{11}{25}{Median number of K-value SSI iterations (with Jex acceleration) required for flash convergence, over the $T$--$P$ plane for six NaCl molalities (columns). At each $(T,P)$ point the median is computed over all 25 CO$_2$ feed fractions $z$, counting only two-phase conditions. Grey regions are single-phase for all $z$ at those $(T,P,m_s)$ conditions. The colormap is clipped at 20; a small number of cells near the phase boundaries exceed this value. Iteration counts are lowest in the interior of the two-phase region and highest near the bubble-point boundary and the CO$_2$ critical point, where K-values approach unity and successive substitution converges slowly}{figure.caption.30}{}}
