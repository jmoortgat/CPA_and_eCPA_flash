\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces CO$_2$ solubility in NaCl brine at hydrothermal temperatures (a) $T = 300\,^\circ $C, (b) $T = 350\,^\circ $C. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure. Open symbols: experimental data \citep  {Takenouchi1965}; lines with markers: eCPA predictions at the experimental NaCl molalities. At $T \geq 400\,^\circ $C, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures (300--900\,bar).}}{45}{figure.caption.51}\protected@file@percent }
\newlabel{fig:co2nacl_highT_SI}{{S3}{45}{CO$_2$ solubility in NaCl brine at hydrothermal temperatures (a) $T = 300\,^\circ $C, (b) $T = 350\,^\circ $C. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure. Open symbols: experimental data \citep {Takenouchi1965}; lines with markers: eCPA predictions at the experimental NaCl molalities. At $T \geq 400\,^\circ $C, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures (300--900\,bar)}{figure.caption.51}{}}
