\newlabel{sec:si}{{S2.2}{38}{Appendix: Additional Validation Figures}{section*.47}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces CO$_2$ + H$_2$O phase equilibria at all 29 temperatures not shown in Fig.~\ref {fig:co2h2o_Tpanel} ($0$--$350\,^\circ $C), 4 panels per row. Each panel shows the CO$_2$ mole fraction in the aqueous phase ($x_{\text  {CO}_2}$, left sub-panel) and H$_2$O mole fraction in the CO$_2$-rich phase ($y_{\text  {H}_2\text  {O}}$, right sub-panel) vs.\ pressure. Open symbols: experimental data \citep  {Coelho2025}; black solid line: CPA (salt-free); rainbow-colored filled bands: eCPA spanning $m_s = 0$--$6$\,mol\,kg$^{-1}$ (violet to red), with discrete molality contours overlaid.}}{39}{figure.caption.48}\protected@file@percent }
\newlabel{fig:co2h2o_Tpanel_SI}{{S1}{39}{CO$_2$ + H$_2$O phase equilibria at all 29 temperatures not shown in Fig.~\ref {fig:co2h2o_Tpanel} ($0$--$350\,^\circ $C), 4 panels per row. Each panel shows the CO$_2$ mole fraction in the aqueous phase ($x_{\text {CO}_2}$, left sub-panel) and H$_2$O mole fraction in the CO$_2$-rich phase ($y_{\text {H}_2\text {O}}$, right sub-panel) vs.\ pressure. Open symbols: experimental data \citep {Coelho2025}; black solid line: CPA (salt-free); rainbow-colored filled bands: eCPA spanning $m_s = 0$--$6$\,mol\,kg$^{-1}$ (violet to red), with discrete molality contours overlaid}{figure.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces CO$_2$ solubility in NaCl brine at nine representative temperatures not shown in Fig.~\ref {fig:co2nacl_Tpanel} ($5$--$200\,^\circ $C), including data at high NaCl molalities up to $m_s = 6$\,mol\,kg$^{-1}$ from multiple sources. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure (log--log). Open symbols: experimental data; lines: eCPA. Colors and markers distinguish NaCl molalities (see legend).}}{40}{figure.caption.49}\protected@file@percent }
\newlabel{fig:co2nacl_Tpanel_SI}{{S2}{40}{CO$_2$ solubility in NaCl brine at nine representative temperatures not shown in Fig.~\ref {fig:co2nacl_Tpanel} ($5$--$200\,^\circ $C), including data at high NaCl molalities up to $m_s = 6$\,mol\,kg$^{-1}$ from multiple sources. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure (log--log). Open symbols: experimental data; lines: eCPA. Colors and markers distinguish NaCl molalities (see legend)}{figure.caption.49}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces CO$_2$ solubility in NaCl brine at hydrothermal temperatures (a) $T = 300\,^\circ $C, (b) $T = 350\,^\circ $C. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure. Open symbols: experimental data \citep  {Takenouchi1965}; lines: eCPA. At $T \geq 400\,^\circ $C, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures (300--900\,bar).}}{41}{figure.caption.50}\protected@file@percent }
\newlabel{fig:co2nacl_highT_SI}{{S3}{41}{CO$_2$ solubility in NaCl brine at hydrothermal temperatures (a) $T = 300\,^\circ $C, (b) $T = 350\,^\circ $C. Each panel shows CO$_2$ molality $m_c$ [mol\,kg$^{-1}$] vs.\ pressure. Open symbols: experimental data \citep {Takenouchi1965}; lines: eCPA. At $T \geq 400\,^\circ $C, eCPA predicts single-phase (fully miscible) behavior for all available experimental pressures (300--900\,bar)}{figure.caption.50}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Heatmap of absolute relative error (AARE, \%) for the CO$_2$ + NaCl validation dataset ($T = 5$--$350\,^\circ $C), showing all individual NaCl molalities present in the experimental data. Color scale is diverging at 5\%: green $\leq 5\%$, red $\geq 10\%$. Empty cells indicate no experimental data at that $(T, m_s)$ combination.}}{41}{figure.caption.51}\protected@file@percent }
\newlabel{fig:co2nacl_heatmap}{{S4}{41}{Heatmap of absolute relative error (AARE, \%) for the CO$_2$ + NaCl validation dataset ($T = 5$--$350\,^\circ $C), showing all individual NaCl molalities present in the experimental data. Color scale is diverging at 5\%: green $\leq 5\%$, red $\geq 10\%$. Empty cells indicate no experimental data at that $(T, m_s)$ combination}{figure.caption.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Aqueous-phase density of CO$_2$-saturated water ($m_s = 0$), without volume shift for H$_2$O. Points colored by temperature; shaded bands show $\pm $1\% and $\pm $2\% deviations. CPA results (not shown) are indistinguishable from eCPA at $m_s = 0$. Experimental data from \citet  {King1992} and \citet  {Nighswander1989} (37 points, $T = 15$--$200\,^\circ $C). The 0.76\% AARE without any Péneloux volume correction for H$_2$O reflects a known strength of the CPA equation of state for liquid water.}}{42}{figure.caption.52}\protected@file@percent }
\newlabel{fig:density}{{S5}{42}{Aqueous-phase density of CO$_2$-saturated water ($m_s = 0$), without volume shift for H$_2$O. Points colored by temperature; shaded bands show $\pm $1\% and $\pm $2\% deviations. CPA results (not shown) are indistinguishable from eCPA at $m_s = 0$. Experimental data from \citet {King1992} and \citet {Nighswander1989} (37 points, $T = 15$--$200\,^\circ $C). The 0.76\% AARE without any Péneloux volume correction for H$_2$O reflects a known strength of the CPA equation of state for liquid water}{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Absolute relative error of eCPA predictions for the CO$_2$ + H$_2$O binary as a function of temperature and pressure. Left: CO$_2$ solubility in the aqueous phase ($x_{\text  {CO}_2}$). Right: H$_2$O content in the CO$_2$-rich phase ($y_{\text  {H}_2\text  {O}}$). Marker color indicates error magnitude (green $< 5\%$, yellow $\approx 10\%$, red $> 30\%$); crosses mark points flagged as outliers by cross-reference consistency analysis. The blue shaded band highlights the pressure range most relevant to subsurface CO$_2$ storage ($P = 50$--$600$\,bar).}}{42}{figure.caption.53}\protected@file@percent }
\newlabel{fig:error_heatmap_SI}{{S6}{42}{Absolute relative error of eCPA predictions for the CO$_2$ + H$_2$O binary as a function of temperature and pressure. Left: CO$_2$ solubility in the aqueous phase ($x_{\text {CO}_2}$). Right: H$_2$O content in the CO$_2$-rich phase ($y_{\text {H}_2\text {O}}$). Marker color indicates error magnitude (green $< 5\%$, yellow $\approx 10\%$, red $> 30\%$); crosses mark points flagged as outliers by cross-reference consistency analysis. The blue shaded band highlights the pressure range most relevant to subsurface CO$_2$ storage ($P = 50$--$600$\,bar)}{figure.caption.53}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces SSI + Newton polish iteration breakdown and wall-time ratio across the parameter-space scan (9{,}825 two-phase points, averaged over $z_{\text  {CO}_2}$). \emph  {Left}: mean SSI iteration count before Newton polish is triggered ($\|\mathbf  {g}\| < 10^{-4}$); the near-CO$_2$-critical region ($T \approx 7$--$57\,^\circ $C) requires the most SSI iterations even with table warm-start. \emph  {Centre}: mean Newton iteration count; most of the domain converges in 2--3 Newton steps after 1--5 SSI steps, while the critical region (blue) often reverts to SSI before Newton is beneficial. \emph  {Right}: wall-time ratio (SSI-only / SSI+Newton); values $>1$ (green) indicate that Newton polish is faster; values $<1$ (red) indicate that the SSI-only path is faster (primarily near the CO$_2$ critical point where Newton reversion adds overhead).}}{43}{figure.caption.54}\protected@file@percent }
\newlabel{fig:newton_heatmap_SI}{{S7}{43}{SSI + Newton polish iteration breakdown and wall-time ratio across the parameter-space scan (9{,}825 two-phase points, averaged over $z_{\text {CO}_2}$). \emph {Left}: mean SSI iteration count before Newton polish is triggered ($\|\mathbf {g}\| < 10^{-4}$); the near-CO$_2$-critical region ($T \approx 7$--$57\,^\circ $C) requires the most SSI iterations even with table warm-start. \emph {Centre}: mean Newton iteration count; most of the domain converges in 2--3 Newton steps after 1--5 SSI steps, while the critical region (blue) often reverts to SSI before Newton is beneficial. \emph {Right}: wall-time ratio (SSI-only / SSI+Newton); values $>1$ (green) indicate that Newton polish is faster; values $<1$ (red) indicate that the SSI-only path is faster (primarily near the CO$_2$ critical point where Newton reversion adds overhead)}{figure.caption.54}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces Flash strategy comparison across all 9{,}825 two-phase conditions ($T = 0$--$425\,^\circ $C, $P = 1$--$1500$\,bar, $z_{\text  {CO}_2} = 0.001$--$0.999$). (a) Convergence rate; (b) mean total iterations (converged points only). Strategies are ordered from simplest cold-start (standard SSI with Wilson K) to the most optimized (table warm-start with SSI and Newton polish). The final strategy achieves a 73\% reduction in mean iterations relative to the standard cold-start.}}{43}{figure.caption.55}\protected@file@percent }
\newlabel{fig:strategy_comparison_SI}{{S8}{43}{Flash strategy comparison across all 9{,}825 two-phase conditions ($T = 0$--$425\,^\circ $C, $P = 1$--$1500$\,bar, $z_{\text {CO}_2} = 0.001$--$0.999$). (a) Convergence rate; (b) mean total iterations (converged points only). Strategies are ordered from simplest cold-start (standard SSI with Wilson K) to the most optimized (table warm-start with SSI and Newton polish). The final strategy achieves a 73\% reduction in mean iterations relative to the standard cold-start}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Distribution of Newton iterations per solver call for the two inner Newton solvers in the eCPA flash: the aqueous-phase solver (blue; converges $Z_w$, $\varepsilon _r$, $\chi _w$) and the \ce {CO2}-rich-phase solver (orange; converges $Z_c$). Histograms are density-normalised and aggregate all two-phase flash evaluations across the full ternary scan ($T$, $P$, $z$, $m_s$). Dashed vertical lines mark the median $\tilde  {n}$. The aqueous solver requires more iterations because it solves three coupled unknowns simultaneously. Both solvers converge in 100\,\% of all evaluated conditions.}}{44}{figure.caption.56}\protected@file@percent }
\newlabel{fig:si_newton_stats}{{S9}{44}{Distribution of Newton iterations per solver call for the two inner Newton solvers in the eCPA flash: the aqueous-phase solver (blue; converges $Z_w$, $\varepsilon _r$, $\chi _w$) and the \ce {CO2}-rich-phase solver (orange; converges $Z_c$). Histograms are density-normalised and aggregate all two-phase flash evaluations across the full ternary scan ($T$, $P$, $z$, $m_s$). Dashed vertical lines mark the median $\tilde {n}$. The aqueous solver requires more iterations because it solves three coupled unknowns simultaneously. Both solvers converge in 100\,\% of all evaluated conditions}{figure.caption.56}{}}
